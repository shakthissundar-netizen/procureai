# Application Settings
PROJECT_NAME="ProcureAI Backend"
API_V1_STR="/api"
DEBUG=True

# Database Configuration (MySQL default, SQLite fallback)
# For MySQL:
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=procureai

# Or direct DATABASE_URL (if provided, overrides DB_* fields above)
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/procureai
# SQLite zero-setup fallback (used automatically if MySQL is unreachable or DATABASE_URL not set):
DATABASE_URL=sqlite:///./procureai.db

# AI Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
USE_MOCK_AI=True
